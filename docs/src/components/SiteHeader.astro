---
const githubUrl = 'https://github.com/russmckendrick/rest';
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="brand">
      <span class="brand__mark brand__mark--badge" aria-hidden="true">
        <img class="brand__logo" src="/logo.svg" alt="" width="42" height="42" decoding="async" />
      </span>
      <span>russ.rest</span>
    </a>
    <nav class="nav-top" aria-label="Primary">
      <a href="/">Docs</a>
      <a href={githubUrl} class="pill" rel="noopener" target="_blank">GitHub</a>
    </nav>
  </div>
</header>
