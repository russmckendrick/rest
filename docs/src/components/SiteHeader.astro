---
const githubUrl = 'https://github.com/russmckendrick/rest';
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="brand">
      <span class="brand__mark" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
          <rect x="1" y="1" width="30" height="30" rx="6" fill="none" stroke="currentColor" stroke-width="1.5"/>
          <text x="16" y="22" font-family="ui-monospace, monospace" font-size="16" font-weight="700" text-anchor="middle" fill="currentColor">r</text>
        </svg>
      </span>
      <span>russ.rest</span>
    </a>
    <nav class="nav-top" aria-label="Primary">
      <a href="/">Docs</a>
      <a href={githubUrl} class="pill" rel="noopener" target="_blank">GitHub</a>
    </nav>
  </div>
</header>
