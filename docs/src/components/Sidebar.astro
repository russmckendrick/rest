---
import { nav } from '../data/nav';

const githubUrl = 'https://github.com/russmckendrick/rest';

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;

function normalize(path: string): string {
  if (path.length > 1 && path.endsWith('/')) return path.slice(0, -1);
  return path;
}

const currentPath = normalize(pathname);
---

<aside class="sidebar" aria-label="Documentation navigation">
  <a href="/" class="sidebar-logo" aria-label="russ.rest home">
    <img src="/logo.svg" alt="" width="220" height="136" decoding="async" />
  </a>
  <div class="sidebar__nav">
    {nav.map((group) => (
      <div class="sidebar__group">
        <p class="sidebar__group-label">{group.section}</p>
        <ul class="sidebar__list">
          {group.items.map((item) => {
            const isActive = normalize(item.href) === currentPath;
            return (
              <li>
                <a
                  href={item.href}
                  class:list={['sidebar__link', isActive && 'is-active']}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </div>
  <div class="sidebar__source">
    <p class="sidebar__group-label">Source</p>
    <a href={githubUrl} class="sidebar__link sidebar__link--external" rel="noopener" target="_blank">
      GitHub
    </a>
  </div>
</aside>
